{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "satslap",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "satslap",
      "database_id": "c2cf254b-bf71-4179-aab1-24333f12a6c6"
    }
  ],
  "routes": [
    {
      "pattern": "satslap.zapm.uk",
      "custom_domain": true
    }
  ]
}
